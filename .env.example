# =============================================
# BIMA CORE — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================

# === REQUIRED ===
OPENROUTER_API_KEY=sk-or-v1-your-key-here
DISCORD_TOKEN=your-discord-bot-token-here

# === OPTIONAL (enhanced features) ===
TELEGRAM_BOT_TOKEN=your-telegram-token
SERPER_API_KEY=your-serper-key
GEMINI_API_KEY=your-gemini-key
RAPIDAPI_KEY=your-rapidapi-key
TAVILY_API_KEY=your-tavily-key

# === CONFIGURATION ===
CREWAI_TELEMETRY_OPT_OUT=true

# === QC Gambar Kerja (!qc) ===
# Override model vision khusus QC tanpa ganggu VISUAL_MODEL_NAME global
# (misal model grounding bbox presisi: qwen/qwen3-vl-235b-a22b-instruct).
# Kosongkan untuk pakai default dari config.py.
# QC_MODEL=
# QC_MAX_PAGES=30
# QC_TARGET_WIDTH_PX=2048
# QC_MAX_FILE_MB=20

# === IMAGE GENERATION (Anisa "/anisa gambar ...") ===
# Model OpenRouter buat text-to-image. Default: Gemini 3.1 Flash Image (Nano Banana 2)
IMAGE_GEN_MODEL=google/gemini-3.1-flash-image
# Optional: prefix gaya konsisten yang di-prepend ke prompt (e.g. "minimalist line art, soft pastel")
IMAGE_GEN_STYLE_PREFIX=

# === VIDEO GENERATION (Anisa "bikin video <prompt>") ===
# Primary: OpenRouter Kling v3 Pro. Fallback: fal.ai Kling v3 Standard.
# WA-only delivery (Discord 25MB limit ketat — Discord trigger di-redirect ke WA)
VIDEO_GEN_MODEL=kwaivgi/kling-v3.0-pro
VIDEO_GEN_DURATION=5
# Optional: tweak polling cap kalau model lambat (default 25 iter * 8s = 200s)
VIDEO_POLL_MAX=25
# fal.ai key untuk fallback path — daftar di https://fal.ai/dashboard/keys (free tier ada credit)
FAL_KEY=

# === BROWSER-USE (live browsing via vision LLM) ===
# Default model untuk web "clean" (GitHub, HuggingFace, dll)
BROWSER_USE_MODEL=google/gemini-3.7-flash
# Model untuk marketplace (Tokopedia/Shopee/Lazada/Bukalapak) — biasanya pilih yang lebih cepat
# karena halaman ramai bikin vision LLM gede lambat
BROWSER_USE_MODEL_MARKETPLACE=google/gemini-3.7-flash
# Visibility: 1 = window kebuka di Windows desktop (WSLg), 0 = headless
BROWSER_USE_HEADED=1
# Record video session ke outputs/browser_use/{ts}/ — useful kalau lo gak liat desktop
BROWSER_USE_RECORD=0

# === DISCORD CHANNELS ===
BOT_STATUS_CHANNEL_ID=your-status-channel-id
SAHAM_CHANNEL_ID=your-saham-channel-id

# === TEAM MEKANIK MAINTENANCE ===
ENABLE_MEKANIK_MT=true
MEKANIK_MT_DAYS=mon,wed,fri
MEKANIK_MT_HOUR=21
MEKANIK_MT_MINUTE=30

# === OBSIDIAN VAULT ===
# On VPS, use local path: OBSIDIAN_PATH=./Bima_Vault
# On WSL, use Windows mount: OBSIDIAN_PATH=/mnt/c/Users/.../BIMA_VAULT/Penyimpanan
OBSIDIAN_PATH=./Bima_Vault

# === DASHBOARD AUTH ===
# Token untuk proteksi API dashboard. Generate random:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=
DASHBOARD_PORT=8000

# === WHATSAPP WEB JS ===
# Nomor owner (format 628xxx, tanpa + atau spasi)
WA_OWNER_NUMBER=628xxxxxxxxxx
# URL bridge server (core/wa_server.py, default port 8001)
WA_BRIDGE_URL=http://127.0.0.1:8001
# Token auth bridge (opsional, buat produksi):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WA_BRIDGE_TOKEN=
# Nama bot di WA
WA_BOT_NAME=Anisa
# Rate limit antar pesan (detik)
WA_RATE_LIMIT=5
# Timeout request ke backend (ms, default 5 menit)
WA_TIMEOUT=300000

# === LangSmith Tracing (optional) ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=Bima Core

# === Sentry Error Tracking (optional) ===
# Free tier 5k events/bulan. Daftar di https://sentry.io → Create Project (Python)
# Salin DSN ke sini. Kosongin = Sentry off (no-op).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
BIMA_ENV=prod

# === Apprise Multi-Channel Notify Fallback (optional) ===
# Comma-separated URL channel buat fallback notifikasi kalau Discord API down.
# Format: lihat https://github.com/caronc/apprise/wiki
# Contoh:
#   tgram://BOT_TOKEN/CHAT_ID  (Telegram)
#   ntfy://default/bima-alerts (ntfy.sh public)
#   pover://USER_KEY@APP_TOKEN  (Pushover)
APPRISE_URLS=

# === STT (Speech-to-Text) — Whisper config ===
# Voice dimatikan default agar model tidak memakai RAM/VRAM atau melakukan download.
ENABLE_STT=false
ENABLE_TTS=false
# Model size options: tiny | base | small | medium | large-v3 | large-v3-turbo | turbo
# Recommended: large-v3-turbo (216x real-time, WER ~5-8% untuk Bahasa Indonesia)
# Fallback: small (kalau ada constraint RAM/CPU)
STT_MODEL_SIZE=large-v3-turbo
# Device: cpu (recommended, ~1.5GB RAM, no VRAM conflict dengan F5-TTS) | cuda
STT_DEVICE=cpu
# Compute type: int8 (CPU efficiency) | int8_float16 | float16 | float32
STT_COMPUTE_TYPE=int8

# === Plugin System ===
# Load custom tools dari tools/plugins/ ke mekanik agent
# Plugin format: file .py dengan fungsi create_tool() return BaseTool instance
ENABLE_PLUGINS=true

# === T1-A: Async Checkpointing (conversation continuity) ===
# Kalau true, percakapan persist antar restart bot (per user+channel thread_id).
# Storage: memory/checkpoints.db (auto-created, safe to delete buat reset state).
ENABLE_CHECKPOINTING=true

# === T1-G: Daily Briefing Scheduler ===
# Opt-in. Kirim morning briefing ke BRIEFING_CHANNEL_ID setiap pagi.
# Default jam: weekday 07:00 WIB, weekend 09:00 WIB.
ENABLE_BRIEFING=false
BRIEFING_CHANNEL_ID=
BRIEFING_HOUR=7
BRIEFING_HOUR_WEEKEND=9

# === T1-E: Conversation Context Summarization ===
# Trigger summarizer node kalau messages > SUMMARIZE_THRESHOLD per thread.
# Hemat token jangka panjang + jaga manager prompt tetap manageable.
ENABLE_SUMMARIZATION=true
SUMMARIZE_THRESHOLD=20
SUMMARIZE_KEEP_LAST=6

# === T1-C: Model Complexity Router ===
# Pilih model berdasarkan kompleksitas tugas (routing/standard/heavy).
# Hemat -40~60% API cost di task ringan.
ENABLE_MODEL_ROUTER=true

# === T1-D: Per-User Daily Cost Guardrails ===
# Pakai OpenRouter `usage` field untuk track ACTUAL cost (bukan estimasi).
# Block user kalau total cost hari ini ≥ DAILY_COST_LIMIT_USD.
ENABLE_COST_GUARDRAILS=false
DAILY_COST_LIMIT_USD=2.0

# === T2-A: Discord Thread Isolation (opt-in via /private) ===
# Kalau aktif, user bisa ketik /private start utk dedicated thread (context isolated).
# Default behavior tetap shared channel — gak rusak UX group.
ENABLE_THREAD_ISOLATION=true

# === T2-C: Streaming Discord Responses ===
# Partial content render saat LLM streaming (sudah ada, flag untuk disable).
ENABLE_STREAMING_DISCORD=true

# === Embedding Backend (Wave 3) ===
# Switch global atau override per domain lewat suffix `_ARSIP` / `_CODE`.
# Arsip production direkomendasikan cloud Qwen3 Embedding 8B, 1024 dim.
# PENTING: ganti model/dim = WAJIB full rebuild index terkait.
EMBEDDING_BACKEND=local
EMBEDDING_BACKEND_ARSIP=cloud
EMBEDDING_MODEL_ARSIP=qwen/qwen3-embedding-8b
EMBEDDING_DIM_ARSIP=1024
EMBED_BATCH_SIZE=64
EMBED_CACHE_TTL_DAYS=30
RERANKER_ENABLED=false

# === Headroom Context Compression (Wave 4) ===
# Compress context (memory recall, conversation summary, recent history)
# sebelum masuk LLM. Hemat 50-95% token tanpa kehilangan semantic meaning.
# Prerequisite: pip install headroom
ENABLE_HEADROOM=false
# Target compression ratio (0.4 = compress ke ~40% panjang asli)
# Semakin rendah = semakin agresif compress. Rekomendasi: 0.3-0.5
HEADROOM_TARGET_RATIO=0.4

# === Threads API Integration ===
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret
THREADS_ACCESS_TOKEN=your-threads-access-token

# === Strix Security Pilot (opt-in, report-only) ===
# Butuh uvx + Docker aktif di WSL. OPENROUTER_API_KEY yang sama dipakai child process.
STRIX_ENABLED=false
STRIX_LLM=openrouter/openai/gpt-5.4
STRIX_IMAGE=ghcr.io/usestrix/strix-sandbox:1.0.0
STRIX_MAX_BUDGET_USD=0.5
STRIX_TIMEOUT_SECONDS=3600

# === Threads Auto Posting Scheduler ===
ENABLE_THREADS_AUTO=true
BIMA_DISCORD_USER_ID=your-discord-user-id-here
